<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="sensor_node">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://sensor_node/meshes/sensor_box.obj</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.10 0.20 0.20</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
