<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="sun_radiant">
    <static>true</static>
    <link name="link">
      <visual name="sun_visual">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <mesh>
            <uri>model://sun_radiant/meshes/sun_radiant.obj</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>1.0 1.0 1.0 1.0</ambient>
          <diffuse>1.0 1.0 1.0 1.0</diffuse>
          <specular>0.0 0.0 0.0 1.0</specular>
          <emissive>1.0 1.0 1.0 1.0</emissive>
          <double_sided>true</double_sided>
          <pbr>
            <metal>
              <albedo_map>model://sun_radiant/materials/textures/sun_radiant.png</albedo_map>
              <emissive_map>model://sun_radiant/materials/textures/sun_radiant.png</emissive_map>
              <roughness>1.0</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
