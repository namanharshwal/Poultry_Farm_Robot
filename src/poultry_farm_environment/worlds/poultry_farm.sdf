<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="poultry_farm">
    <!-- Physics Settings -->
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver><type>quick</type><iters>50</iters><sor>1.3</sor></solver>
        <constraints><cfm>0.00001</cfm><erp>0.2</erp><contact_max_correcting_vel>100.0</contact_max_correcting_vel><contact_surface_layer>0.001</contact_surface_layer></constraints>
      </ode>
    </physics>

    <!-- Gazebo Sim Essential Systems -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <!-- Scene & Atmosphere with Sky and Clouds -->
    <scene>
      <ambient>0.68 0.66 0.62 1.0</ambient>
      <background>0.55 0.75 0.95 1.0</background>
      <shadows>true</shadows>
      <grid>false</grid>
      <sky>
        <time>12.0</time>
        <sunrise>6.0</sunrise>
        <sunset>18.0</sunset>
        <clouds>
          <speed>0.8</speed>
          <direction>1.0 0.0</direction>
          <humidity>0.6</humidity>
          <mean_size>0.5</mean_size>
          <ambient>0.8 0.8 0.8 1.0</ambient>
        </clouds>
      </sky>
    </scene>

    <!-- GUI Camera Configuration with Far Clipping Plane -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-25.8 8.2 5.1 0 0.12 -0.05</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
        <clip>
          <near>0.1</near>
          <far>1000.0</far>
        </clip>
      </camera>
    </gui>

    <!-- Radiant Glowing Sun in the Sky with Clouds -->
    <include>
      <name>sun_radiant</name>
      <uri>model://sun_radiant</uri>
      <pose>-32.0 54.0 64.0 0 0 0</pose>
    </include>

    <!-- Natural Directional Sunlight aligned with Radiant Sun -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>-32.0 54.0 64.0 0 0 0</pose>
      <diffuse>0.98 0.95 0.88 1</diffuse>
      <specular>0.4 0.4 0.4 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>0.3714 -0.5571 -0.7428</direction>
    </light>

    <!-- Spotlight illuminating the Roman Named Signboard at the Front Gate -->
    <light type="spot" name="entrance_sign_spotlight">
      <cast_shadows>false</cast_shadows>
      <pose>-24.5 8.0 5.2 0 0.45 0</pose>
      <diffuse>1.0 0.96 0.82 1</diffuse>
      <specular>0.5 0.5 0.4 1</specular>
      <direction>1.0 0.0 -0.45</direction>
      <attenuation><range>16.0</range><constant>0.2</constant><linear>0.08</linear><quadratic>0.02</quadratic></attenuation>
      <spot><inner_angle>0.6</inner_angle><outer_angle>1.1</outer_angle><falloff>1.0</falloff></spot>
    </light>

    <!-- Interior Lighting: Tunnel Barn 1 (Floor House, Y = 0) -->
    <light type="point" name="tunnel1_light_1">
      <cast_shadows>false</cast_shadows>
      <pose>-8.0 -2.0 3.2 0 0 0</pose>
      <diffuse>0.85 0.82 0.70 1</diffuse>
      <specular>0.2 0.2 0.15 1</specular>
      <attenuation><range>12.0</range><constant>0.2</constant><linear>0.15</linear><quadratic>0.05</quadratic></attenuation>
    </light>
    <light type="point" name="tunnel1_light_2">
      <cast_shadows>false</cast_shadows>
      <pose>-8.0 2.0 3.2 0 0 0</pose>
      <diffuse>0.85 0.82 0.70 1</diffuse>
      <specular>0.2 0.2 0.15 1</specular>
      <attenuation><range>12.0</range><constant>0.2</constant><linear>0.15</linear><quadratic>0.05</quadratic></attenuation>
    </light>
    <light type="point" name="tunnel1_light_3">
      <cast_shadows>false</cast_shadows>
      <pose>-3.0 -2.0 3.2 0 0 0</pose>
      <diffuse>0.85 0.82 0.70 1</diffuse>
      <specular>0.2 0.2 0.15 1</specular>
      <attenuation><range>12.0</range><constant>0.2</constant><linear>0.15</linear><quadratic>0.05</quadratic></attenuation>
    </light>
    <light type="point" name="tunnel1_light_4">
      <cast_shadows>false</cast_shadows>
      <pose>-3.0 2.0 3.2 0 0 0</pose>
      <diffuse>0.85 0.82 0.70 1</diffuse>
      <specular>0.2 0.2 0.15 1</specular>
      <attenuation><range>12.0</range><constant>0.2</constant><linear>0.15</linear><quadratic>0.05</quadratic></attenuation>
    </light>
    <light type="point" name="tunnel1_light_5">
      <cast_shadows>false</cast_shadows>
      <pose>3.0 -2.0 3.2 0 0 0</pose>
      <diffuse>0.85 0.82 0.70 1</diffuse>
      <specular>0.2 0.2 0.15 1</specular>
      <attenuation><range>12.0</range><constant>0.2</constant><linear>0.15</linear><quadratic>0.05</quadratic></attenuation>
    </light>
    <light type="point" name="tunnel1_light_6">
      <cast_shadows>false</cast_shadows>
      <pose>3.0 2.0 3.2 0 0 0</pose>
      <diffuse>0.85 0.82 0.70 1</diffuse>
      <specular>0.2 0.2 0.15 1</specular>
      <attenuation><range>12.0</range><constant>0.2</constant><linear>0.15</linear><quadratic>0.05</quadratic></attenuation>
    </light>
    <light type="point" name="tunnel1_light_7">
      <cast_shadows>false</cast_shadows>
      <pose>8.0 -2.0 3.2 0 0 0</pose>
      <diffuse>0.85 0.82 0.70 1</diffuse>
      <specular>0.2 0.2 0.15 1</specular>
      <attenuation><range>12.0</range><constant>0.2</constant><linear>0.15</linear><quadratic>0.05</quadratic></attenuation>
    </light>
    <light type="point" name="tunnel1_light_8">
      <cast_shadows>false</cast_shadows>
      <pose>8.0 2.0 3.2 0 0 0</pose>
      <diffuse>0.85 0.82 0.70 1</diffuse>
      <specular>0.2 0.2 0.15 1</specular>
      <attenuation><range>12.0</range><constant>0.2</constant><linear>0.15</linear><quadratic>0.05</quadratic></attenuation>
    </light>

    <!-- Interior Lighting: Tunnel Barn 2 (5-Tier Layer House, Y = 16) -->
    <light type="point" name="tunnel2_light_1">
      <cast_shadows>false</cast_shadows>
      <pose>-8.0 14.0 3.4 0 0 0</pose>
      <diffuse>0.90 0.88 0.78 1</diffuse>
      <specular>0.2 0.2 0.15 1</specular>
      <attenuation><range>14.0</range><constant>0.2</constant><linear>0.12</linear><quadratic>0.04</quadratic></attenuation>
    </light>
    <light type="point" name="tunnel2_light_2">
      <cast_shadows>false</cast_shadows>
      <pose>-8.0 18.0 3.4 0 0 0</pose>
      <diffuse>0.90 0.88 0.78 1</diffuse>
      <specular>0.2 0.2 0.15 1</specular>
      <attenuation><range>14.0</range><constant>0.2</constant><linear>0.12</linear><quadratic>0.04</quadratic></attenuation>
    </light>
    <light type="point" name="tunnel2_light_3">
      <cast_shadows>false</cast_shadows>
      <pose>-3.0 14.0 3.4 0 0 0</pose>
      <diffuse>0.90 0.88 0.78 1</diffuse>
      <specular>0.2 0.2 0.15 1</specular>
      <attenuation><range>14.0</range><constant>0.2</constant><linear>0.12</linear><quadratic>0.04</quadratic></attenuation>
    </light>
    <light type="point" name="tunnel2_light_4">
      <cast_shadows>false</cast_shadows>
      <pose>-3.0 18.0 3.4 0 0 0</pose>
      <diffuse>0.90 0.88 0.78 1</diffuse>
      <specular>0.2 0.2 0.15 1</specular>
      <attenuation><range>14.0</range><constant>0.2</constant><linear>0.12</linear><quadratic>0.04</quadratic></attenuation>
    </light>
    <light type="point" name="tunnel2_light_5">
      <cast_shadows>false</cast_shadows>
      <pose>3.0 14.0 3.4 0 0 0</pose>
      <diffuse>0.90 0.88 0.78 1</diffuse>
      <specular>0.2 0.2 0.15 1</specular>
      <attenuation><range>14.0</range><constant>0.2</constant><linear>0.12</linear><quadratic>0.04</quadratic></attenuation>
    </light>
    <light type="point" name="tunnel2_light_6">
      <cast_shadows>false</cast_shadows>
      <pose>3.0 18.0 3.4 0 0 0</pose>
      <diffuse>0.90 0.88 0.78 1</diffuse>
      <specular>0.2 0.2 0.15 1</specular>
      <attenuation><range>14.0</range><constant>0.2</constant><linear>0.12</linear><quadratic>0.04</quadratic></attenuation>
    </light>
    <light type="point" name="tunnel2_light_7">
      <cast_shadows>false</cast_shadows>
      <pose>8.0 14.0 3.4 0 0 0</pose>
      <diffuse>0.90 0.88 0.78 1</diffuse>
      <specular>0.2 0.2 0.15 1</specular>
      <attenuation><range>14.0</range><constant>0.2</constant><linear>0.12</linear><quadratic>0.04</quadratic></attenuation>
    </light>
    <light type="point" name="tunnel2_light_8">
      <cast_shadows>false</cast_shadows>
      <pose>8.0 18.0 3.4 0 0 0</pose>
      <diffuse>0.90 0.88 0.78 1</diffuse>
      <specular>0.2 0.2 0.15 1</specular>
      <attenuation><range>14.0</range><constant>0.2</constant><linear>0.12</linear><quadratic>0.04</quadratic></attenuation>
    </light>

    <!-- Spot Lighting for Egg Separation Mill Station -->
    <light type="point" name="egg_mill_spotlight">
      <cast_shadows>false</cast_shadows>
      <pose>-9.8 16.0 3.0 0 0 0</pose>
      <diffuse>1.0 1.0 0.95 1</diffuse>
      <specular>0.4 0.4 0.4 1</specular>
      <attenuation><range>8.0</range><constant>0.2</constant><linear>0.1</linear><quadratic>0.03</quadratic></attenuation>
    </light>

    <!-- Master Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>140 140</size></plane></geometry><surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>140 140</size></plane></geometry><material><ambient>0.5 0.6 0.4 1</ambient><diffuse>0.5 0.6 0.4 1</diffuse><pbr><metal><albedo_map>model://poultry_farm_world/materials/textures/grass_pasture.png</albedo_map></metal></pbr></material></visual>
      </link>
    </model>

    <!-- Connecting Service Roadway -->
    <model name="inter_tunnel_service_road">
      <static>true</static><pose>0 8.0 0.015 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>30.0 6.0 0.03</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>30.0 6.0 0.03</size></box></geometry><material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse><pbr><metal><albedo_map>model://poultry_farm_world/materials/textures/concrete_floor.png</albedo_map></metal></pbr></material></visual>
      </link>
    </model>

    <!-- Front Logistics Apron -->
    <model name="front_logistics_apron">
      <static>true</static><pose>-15.5 8.0 0.015 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12.0 24.0 0.03</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12.0 24.0 0.03</size></box></geometry><material><ambient>0.70 0.70 0.70 1</ambient><diffuse>0.70 0.70 0.70 1</diffuse><pbr><metal><albedo_map>model://poultry_farm_world/materials/textures/concrete_floor.png</albedo_map></metal></pbr></material></visual>
      </link>
    </model>

    <!-- Outer Driveway Approach Road (Connecting Gate to Apron) -->
    <model name="driveway_approach_road">
      <static>true</static><pose>-24.0 8.0 0.012 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8.0 6.0 0.024</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>8.0 6.0 0.024</size></box></geometry><material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.68 0.68 0.68 1</diffuse><pbr><metal><albedo_map>model://poultry_farm_world/materials/textures/concrete_floor.png</albedo_map></metal></pbr></material></visual>
      </link>
    </model>

    <!-- ================================================================= -->
    <!-- PERIMETER FARM FENCING & FRONT ENTRANCE GATE                     -->
    <!-- ================================================================= -->
    <!-- Continuous boundary fencing enclosing X:[-21, +21], Y:[-15, +27] -->
    <include>
      <name>farm_perimeter_fence</name>
      <uri>model://farm_perimeter_fence</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Grand Front Entrance Gate with Roman Named Signboard ("POULTRY FARM") -->
    <include>
      <name>farm_front_entrance_gate</name>
      <uri>model://farm_entrance_gate</uri>
      <pose>-21.0 8.0 0 0 0 0</pose>
    </include>

    <!-- ================================================================= -->
    <!-- POULTRY FARM WORKERS (OUTER GARDEN, PADDOCK & LOGISTICS)        -->
    <!-- ================================================================= -->
    <!-- 1. Farm Supervisor: Standing on logistics apron near entrance gate -->
    <include>
      <name>worker_supervisor</name>
      <uri>model://farm_worker_supervisor</uri>
      <pose>-17.5 8.0 0 0 0 0</pose>
    </include>

    <!-- 2. Caretaker 1: In the outer south garden / paddock watching free-range hens -->
    <include>
      <name>worker_caretaker_paddock</name>
      <uri>model://farm_worker_caretaker</uri>
      <pose>-2.5 -8.0 0 0 0 1.2</pose>
    </include>

    <!-- 3. Caretaker 2: In outer grass garden near east paddock boundary -->
    <include>
      <name>worker_caretaker_garden</name>
      <uri>model://farm_worker_caretaker</uri>
      <pose>3.5 -7.0 0 0 0 -1.8</pose>
    </include>

    <!-- 4. Logistics Operator 1: Near bulk feed storage silos -->
    <include>
      <name>worker_silo_operator</name>
      <uri>model://farm_worker_logistics</uri>
      <pose>-15.2 -2.5 0 0 0 1.57</pose>
    </include>

    <!-- 5. Logistics Operator 2: Outside Egg Separation Mill loading dock -->
    <include>
      <name>worker_mill_operator</name>
      <uri>model://farm_worker_logistics</uri>
      <pose>-12.8 16.5 0 0 0 -0.5</pose>
    </include>

    <!-- ================================================================= -->
    <!-- TUNNEL BARN 1: FLOOR HOUSING / BROILER & FREE-RANGE FLOCK         -->
    <!-- ================================================================= -->
    <include><name>poultry_barn_tunnel_1</name><uri>model://poultry_barn</uri><pose>0 0 0 0 0 0</pose></include>
    <model name="tunnel1_bedding_floor"><static>true</static><pose>0 0 0.01 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>23.6 9.6 0.02</size></box></geometry></collision><visual name="visual"><geometry><box><size>23.6 9.6 0.02</size></box></geometry><material><ambient>0.6 0.5 0.3 1</ambient><diffuse>0.7 0.6 0.4 1</diffuse><pbr><metal><albedo_map>model://poultry_farm_world/materials/textures/litter_bedding.png</albedo_map></metal></pbr></material></visual></link></model>
    <model name="tunnel1_central_runner"><static>true</static><pose>0 0 0.018 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>23.4 1.5 0.005</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual></link></model>
    <model name="tunnel1_charging_dock"><static>true</static><pose>-11.2 0 0.025 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.8 0.8 0.02</size></box></geometry><material><ambient>0.8 0.6 0.1 1</ambient><diffuse>0.9 0.7 0.1 1</diffuse></material></visual></link></model>

    <!-- Tunnel 1 Feed Silos & Fans -->
    <include><name>feed_silo_1</name><uri>model://feed_silo</uri><pose>-14.5 -6.5 0 0 0 0</pose></include>
    <include><name>feed_silo_2</name><uri>model://feed_silo</uri><pose>-14.5 -3.5 0 0 0 0</pose></include>
    for fname, fx, fy, fz in [("t1_fan_1", 12.0, -2.4, 1.5), ("t1_fan_2", 12.0, -0.8, 1.5), ("t1_fan_3", 12.0, 0.8, 1.5), ("t1_fan_4", 12.0, 2.4, 1.5)]:
    <include><name>t1_fan_1</name><uri>model://tunnel_fan</uri><pose>12.0 -2.4 1.5 0 0 3.141592653589793</pose></include>
    <include><name>t1_fan_2</name><uri>model://tunnel_fan</uri><pose>12.0 -0.8 1.5 0 0 3.141592653589793</pose></include>
    <include><name>t1_fan_3</name><uri>model://tunnel_fan</uri><pose>12.0 0.8 1.5 0 0 3.141592653589793</pose></include>
    <include><name>t1_fan_4</name><uri>model://tunnel_fan</uri><pose>12.0 2.4 1.5 0 0 3.141592653589793</pose></include>

    <!-- Tunnel 1 Brooder Heaters -->
    <include><name>t1_heater_1</name><uri>model://brooder_heater</uri><pose>-6.0 0.0 2.6 0 0 0</pose></include>
    <include><name>t1_heater_2</name><uri>model://brooder_heater</uri><pose>-2.0 0.0 2.6 0 0 0</pose></include>
    <include><name>t1_heater_3</name><uri>model://brooder_heater</uri><pose>2.0 0.0 2.6 0 0 0</pose></include>
    <include><name>t1_heater_4</name><uri>model://brooder_heater</uri><pose>6.0 0.0 2.6 0 0 0</pose></include>

    <!-- Tunnel 1 Feeder Lines & Drinker Lines -->
    <include><name>t1_feeder_n_1</name><uri>model://feeder_pan</uri><pose>-9.0 2.6 0.15 0 0 0</pose></include>
    <include><name>t1_feeder_s_1</name><uri>model://feeder_pan</uri><pose>-9.0 -2.6 0.15 0 0 0</pose></include>
    <include><name>t1_feeder_n_2</name><uri>model://feeder_pan</uri><pose>-7.0 2.6 0.15 0 0 0</pose></include>
    <include><name>t1_feeder_s_2</name><uri>model://feeder_pan</uri><pose>-7.0 -2.6 0.15 0 0 0</pose></include>
    <include><name>t1_feeder_n_3</name><uri>model://feeder_pan</uri><pose>-5.0 2.6 0.15 0 0 0</pose></include>
    <include><name>t1_feeder_s_3</name><uri>model://feeder_pan</uri><pose>-5.0 -2.6 0.15 0 0 0</pose></include>
    <include><name>t1_feeder_n_4</name><uri>model://feeder_pan</uri><pose>-3.0 2.6 0.15 0 0 0</pose></include>
    <include><name>t1_feeder_s_4</name><uri>model://feeder_pan</uri><pose>-3.0 -2.6 0.15 0 0 0</pose></include>
    <include><name>t1_feeder_n_5</name><uri>model://feeder_pan</uri><pose>-1.0 2.6 0.15 0 0 0</pose></include>
    <include><name>t1_feeder_s_5</name><uri>model://feeder_pan</uri><pose>-1.0 -2.6 0.15 0 0 0</pose></include>
    <include><name>t1_feeder_n_6</name><uri>model://feeder_pan</uri><pose>1.0 2.6 0.15 0 0 0</pose></include>
    <include><name>t1_feeder_s_6</name><uri>model://feeder_pan</uri><pose>1.0 -2.6 0.15 0 0 0</pose></include>
    <include><name>t1_feeder_n_7</name><uri>model://feeder_pan</uri><pose>3.0 2.6 0.15 0 0 0</pose></include>
    <include><name>t1_feeder_s_7</name><uri>model://feeder_pan</uri><pose>3.0 -2.6 0.15 0 0 0</pose></include>
    <include><name>t1_feeder_n_8</name><uri>model://feeder_pan</uri><pose>5.0 2.6 0.15 0 0 0</pose></include>
    <include><name>t1_feeder_s_8</name><uri>model://feeder_pan</uri><pose>5.0 -2.6 0.15 0 0 0</pose></include>
    <include><name>t1_feeder_n_9</name><uri>model://feeder_pan</uri><pose>7.0 2.6 0.15 0 0 0</pose></include>
    <include><name>t1_feeder_s_9</name><uri>model://feeder_pan</uri><pose>7.0 -2.6 0.15 0 0 0</pose></include>
    <include><name>t1_feeder_n_10</name><uri>model://feeder_pan</uri><pose>9.0 2.6 0.15 0 0 0</pose></include>
    <include><name>t1_feeder_s_10</name><uri>model://feeder_pan</uri><pose>9.0 -2.6 0.15 0 0 0</pose></include>
    <include><name>t1_drinker_n_1</name><uri>model://drinker_line</uri><pose>-8.0 1.4 0.28 0 0 0</pose></include>
    <include><name>t1_drinker_s_1</name><uri>model://drinker_line</uri><pose>-8.0 -1.4 0.28 0 0 0</pose></include>
    <include><name>t1_drinker_n_2</name><uri>model://drinker_line</uri><pose>-4.0 1.4 0.28 0 0 0</pose></include>
    <include><name>t1_drinker_s_2</name><uri>model://drinker_line</uri><pose>-4.0 -1.4 0.28 0 0 0</pose></include>
    <include><name>t1_drinker_n_3</name><uri>model://drinker_line</uri><pose>0.0 1.4 0.28 0 0 0</pose></include>
    <include><name>t1_drinker_s_3</name><uri>model://drinker_line</uri><pose>0.0 -1.4 0.28 0 0 0</pose></include>
    <include><name>t1_drinker_n_4</name><uri>model://drinker_line</uri><pose>4.0 1.4 0.28 0 0 0</pose></include>
    <include><name>t1_drinker_s_4</name><uri>model://drinker_line</uri><pose>4.0 -1.4 0.28 0 0 0</pose></include>
    <include><name>t1_drinker_n_5</name><uri>model://drinker_line</uri><pose>8.0 1.4 0.28 0 0 0</pose></include>
