<?xml version="1.0"?>
<robot name="poultry_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================================================================== -->
  <!-- CONSTANTS & PROPERTIES                                                -->
  <!-- ===================================================================== -->
  <xacro:property name="chassis_mass" value="32.0"/>
  <xacro:property name="chassis_length" value="0.76"/>
  <xacro:property name="chassis_width" value="0.50"/>
  <xacro:property name="chassis_height" value="0.22"/>

  <xacro:property name="wheel_mass" value="2.5"/>
  <xacro:property name="wheel_radius" value="0.11"/>
  <xacro:property name="wheel_width" value="0.07"/>
  <xacro:property name="wheel_track" value="0.56"/>
  <xacro:property name="wheel_base" value="0.46"/>

  <xacro:property name="scraper_mass" value="4.0"/>
  <xacro:property name="scraper_width" value="0.62"/>
  <xacro:property name="scraper_height" value="0.10"/>

  <!-- Color Materials -->
  <material name="agricultural_yellow">
    <color rgba="0.95 0.78 0.05 1.0"/>
  </material>
  <material name="chassis_dark">
    <color rgba="0.18 0.20 0.22 1.0"/>
  </material>
  <material name="rubber_tread">
    <color rgba="0.10 0.10 0.10 1.0"/>
  </material>
  <material name="stainless_steel">
    <color rgba="0.85 0.85 0.88 1.0"/>
  </material>
  <material name="sensor_blue">
    <color rgba="0.10 0.40 0.85 1.0"/>
  </material>
  <material name="lens_glass">
    <color rgba="0.05 0.05 0.08 0.9"/>
  </material>
  <material name="led_emissive">
    <color rgba="1.0 0.98 0.85 1.0"/>
  </material>

  <!-- ===================================================================== -->
  <!-- BASE FOOTPRINT & BASE LINK                                            -->
  <!-- ===================================================================== -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <!-- Main Low-Profile Chassis Body -->
    <visual>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="agricultural_yellow"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>

    <!-- Lower Protective Skid Plate -->
    <visual>
      <origin xyz="0 0 -0.02" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length + 0.04} ${chassis_width - 0.04} 0.02"/>
      </geometry>
      <material name="chassis_dark"/>
    </visual>

    <!-- Upper Sealed Electronics Hood -->
    <visual>
      <origin xyz="-0.06 0 0.20" rpy="0 0 0"/>
      <geometry>
        <box size="0.44 0.40 0.04"/>
      </geometry>
      <material name="chassis_dark"/>
    </visual>

    <!-- Inspection LED Floodlights (Left & Right) -->
    <visual>
      <origin xyz="0.38 0.16 0.12" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.08 0.04"/>
      </geometry>
      <material name="led_emissive"/>
    </visual>
    <visual>
      <origin xyz="0.38 -0.16 0.12" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.08 0.04"/>
      </geometry>
      <material name="led_emissive"/>
    </visual>

    <inertial>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <mass value="${chassis_mass}"/>
      <inertia
        ixx="${(1.0/12.0) * chassis_mass * (chassis_width*chassis_width + chassis_height*chassis_height)}"
        ixy="0.0" ixz="0.0"
        iyy="${(1.0/12.0) * chassis_mass * (chassis_length*chassis_length + chassis_height*chassis_height)}"
        iyz="0.0"
        izz="${(1.0/12.0) * chassis_mass * (chassis_length*chassis_length + chassis_width*chassis_width)}"/>
    </inertial>
  </link>

  <!-- ===================================================================== -->
  <!-- FRONT MANURE SCRAPER BLADE                                            -->
  <!-- ===================================================================== -->
  <link name="scraper_blade_link">
    <!-- Curved Stainless Steel Scraper Blade -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 ${scraper_width} ${scraper_height}"/>
      </geometry>
      <material name="stainless_steel"/>
    </visual>
    <!-- Heavy-Duty Rubber Bottom Squeegee (cleans wood shavings/bedding) -->
    <visual>
      <origin xyz="0.01 0 -0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 ${scraper_width} 0.02"/>
      </geometry>
      <material name="rubber_tread"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 ${scraper_width} ${scraper_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${scraper_mass}"/>
      <inertia
        ixx="0.08" ixy="0.0" ixz="0.0"
        iyy="0.01" iyz="0.0"
        izz="0.08"/>
    </inertial>
  </link>

  <joint name="scraper_blade_joint" type="fixed">
    <parent link="base_link"/>
    <child link="scraper_blade_link"/>
    <!-- Positioned directly in front at floor level -->
    <origin xyz="${chassis_length/2 + 0.04} 0 -0.04" rpy="0 0 0"/>
  </joint>

  <!-- ===================================================================== -->
  <!-- 4-WHEEL ALL-TERRAIN RUBBER TREAD DRIVETRAIN                          -->
  <!-- ===================================================================== -->
  <xacro:macro name="poultry_wheel" params="prefix x_reflect y_reflect">
    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="rubber_tread"/>
      </visual>
      <!-- Rim Accent -->
      <visual>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius * 0.55}" length="${wheel_width + 0.005}"/>
        </geometry>
        <material name="agricultural_yellow"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia
          ixx="${(1.0/12.0) * wheel_mass * (3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"
          ixy="0.0" ixz="0.0"
          iyy="${(1.0/12.0) * wheel_mass * (3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"
          iyz="0.0"
          izz="${0.5 * wheel_mass * wheel_radius * wheel_radius}"/>
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="${x_reflect * wheel_base/2} ${y_reflect * wheel_track/2} 0.0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <gazebo reference="${prefix}_wheel">
      <mu1>1.2</mu1>
      <mu2>1.0</mu2>
      <kp>1000000.0</kp>
      <kd>10.0</kd>
      <minDepth>0.003</minDepth>
      <maxVel>2.0</maxVel>
      <material>Gazebo/DarkGrey</material>
    </gazebo>
  </xacro:macro>

  <xacro:poultry_wheel prefix="front_left"  x_reflect="1"  y_reflect="1"/>
  <xacro:poultry_wheel prefix="front_right" x_reflect="1"  y_reflect="-1"/>
  <xacro:poultry_wheel prefix="rear_left"   x_reflect="-1" y_reflect="1"/>
  <xacro:poultry_wheel prefix="rear_right"  x_reflect="-1" y_reflect="-1"/>

  <!-- ===================================================================== -->
  <!-- SENSOR MAST & ENVIRONMENTAL POD                                       -->
  <!-- ===================================================================== -->
  <link name="mast_link">
    <visual>
      <origin xyz="0 0 0.16" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.32"/>
      </geometry>
      <material name="chassis_dark"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.32" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.14 0.04"/>
      </geometry>
      <material name="stainless_steel"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.16" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.32"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.16" rpy="0 0 0"/>
      <mass value="1.2"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.005"/>
    </inertial>
  </link>

  <joint name="mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mast_link"/>
    <origin xyz="0.12 0 0.19" rpy="0 0 0"/>
  </joint>

  <!-- Environmental Sensing Pod (NH3 Ammonia, CO2, Temp/Humidity) -->
  <link name="gas_sensor_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.06"/>
      </geometry>
      <material name="sensor_blue"/>
    </visual>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="gas_sensor_joint" type="fixed">
    <parent link="mast_link"/>
    <child link="gas_sensor_link"/>
    <origin xyz="-0.04 0 0.22" rpy="0 0 0"/>
  </joint>

  <!-- ===================================================================== -->
  <!-- 360° 16-BEAM 3D GPU LIDAR                                             -->
  <!-- ===================================================================== -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.065"/>
      </geometry>
      <material name="sensor_blue"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.048" length="0.03"/>
      </geometry>
      <material name="lens_glass"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.065"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.8"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="mast_link"/>
    <child link="lidar_link"/>
    <!-- Positioned at top of mast Z = 0.36 above base -->
    <origin xyz="0 0 0.36" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_link">
    <sensor name="gpu_lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.1415926</min_angle>
            <max_angle>3.1415926</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <resolution>1</resolution>
            <min_angle>-0.261799</min_angle>
            <max_angle>0.261799</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.15</min>
          <max>25.0</max>
          <resolution>0.02</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <topic>/scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
    </sensor>
  </gazebo>

  <!-- ===================================================================== -->
  <!-- INTEL REALSENSE D435 RGB-D CAMERA WITH OPTICAL FRAME CONVENTION       -->
  <!-- ===================================================================== -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.090 0.025"/>
      </geometry>
      <material name="stainless_steel"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.025 0.090 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.25"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="mast_link"/>
    <child link="camera_link"/>
    <!-- Angled slightly downward (10 deg pitch = 0.1745 rad) to view floor hens/eggs -->
    <origin xyz="0.05 0 0.18" rpy="0 0.1745 0"/>
  </joint>

  <!-- Standard ROS Optical Coordinate Convention: R,P,Y = [-90°, 0°, -90°] -->
  <link name="camera_depth_optical_frame"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_depth_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>

  <gazebo reference="camera_link">
    <!-- RGB Color Camera -->
    <sensor name="camera_rgb" type="camera">
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <update_rate>20</update_rate>
      <visualize>false</visualize>
      <camera>
        <horizontal_fov>1.5184</horizontal_fov> <!-- 87 deg H FOV -->
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.10</near>
          <far>15.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
      <topic>/camera/color/image_raw</topic>
      <gz_frame_id>camera_depth_optical_frame</gz_frame_id>
    </sensor>

    <!-- Depth Camera Sensor -->
    <sensor name="camera_depth" type="depth_camera">
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <update_rate>20</update_rate>
      <visualize>false</visualize>
      <camera>
        <horizontal_fov>1.5184</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R_FLOAT32</format>
        </image>
        <clip>
          <near>0.15</near>
          <far>10.0</far>
        </clip>
      </camera>
      <topic>/camera/depth/image_raw</topic>
      <gz_frame_id>camera_depth_optical_frame</gz_frame_id>
    </sensor>
  </gazebo>

  <!-- ===================================================================== -->
  <!-- 9-DOF IMU SENSOR                                                      -->
  <!-- ===================================================================== -->
  <link name="imu_link">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
  </joint>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>false</visualize>
      <topic>/imu/data</topic>
      <gz_frame_id>imu_link</gz_frame_id>
    </sensor>
  </gazebo>

  <!-- ===================================================================== -->
  <!-- GAZEBO SIMULATION PLUGINS                                             -->
  <!-- ===================================================================== -->
  <gazebo>
    <!-- 4WD Differential Drive / Skid-Steer Controller -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <!-- Left side wheels -->
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>

      <!-- Right side wheels -->
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>

      <wheel_separation>${wheel_track}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>

      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>

    <!-- Joint State Publisher Plugin -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

</robot>
